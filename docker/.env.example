# 复制为同目录的 .env 后按需修改（.env 已被 .gitignore 忽略）。
# docker compose 会自动读取这个文件做变量插值，未提供时用 docker-compose.yml 里的默认值。

# ---- Qdrant ----
# 留空 = 不开鉴权；开启时同步取消 docker-compose.yml 里的
# QDRANT__SERVICE__API_KEY 注释，并改 cosmos.yaml 的 memory.qdrant.api_key。
QDRANT_API_KEY=
# 宿主机端口，与本地已占用端口冲突时改这里。
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO

# ---- TigerGraph ----
TIGERGRAPH_VERSION=4.2.2
TIGERGRAPH_SSH_PORT=14022
TIGERGRAPH_RESTPP_PORT=9000
TIGERGRAPH_STUDIO_PORT=14240
